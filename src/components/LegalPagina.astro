---
// Plantilla común de las páginas legales: cabecera + texto con estilo de lectura.
import Layout from '../layouts/Layout.astro';
import { ajustes } from '../data/legal';

interface Props {
  titulo: string;
  descripcion: string;
}
const { titulo, descripcion } = Astro.props;
---

<Layout title={titulo} description={descripcion}>
  <section class="max-w-content mx-auto px-6 md:px-8 pt-16 pb-24">
    <p class="eyebrow-ochre mb-3">Información legal</p>
    <h1 class="font-sans font-extrabold text-4xl md:text-5xl mb-3">{titulo}</h1>
    <p class="font-mono text-xs text-cream/40 mb-10">Última actualización: {ajustes.actualizado}</p>

    <div
      class="max-w-2xl text-cream/70 text-sm leading-relaxed
             [&_h2]:font-sans [&_h2]:font-extrabold [&_h2]:text-lg [&_h2]:text-cream [&_h2]:mt-10 [&_h2]:mb-3
             [&_p]:mb-4 [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:space-y-1.5 [&_ul]:mb-4
             [&_strong]:text-cream/90 [&_a]:underline [&_a]:underline-offset-2 hover:[&_a]:text-cream
             [&_code]:font-mono [&_code]:text-[.8rem] [&_code]:text-cream/85"
    >
      <slot />
    </div>
  </section>
</Layout>
