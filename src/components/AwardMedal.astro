---
import type { Premio } from '../data/contenido';

interface Props {
  premio: Premio;
}
const { premio } = Astro.props;
---

<div class="flex items-center gap-4">
  <div class="w-[52px] h-[52px] rounded-full flex-shrink-0 bg-sea-2 border-[1.5px] border-ochre flex items-center justify-center relative">
    <div class="absolute -inset-[5px] rounded-full border border-dashed border-ochre/40"></div>
    {premio.icono === 'medalla' ? (
      <svg viewBox="0 0 24 24" fill="none" stroke="#b8862f" stroke-width="1.5" class="w-[22px] h-[22px]">
        <circle cx="12" cy="8" r="5" />
        <path d="M8.5 12.5 7 21l5-3 5 3-1.5-8.5" />
      </svg>
    ) : (
      <svg viewBox="0 0 24 24" fill="none" stroke="#b8862f" stroke-width="1.5" class="w-[22px] h-[22px]">
        <rect x="4" y="4" width="16" height="16" rx="2" />
        <path d="M8 9h8M8 12.5h5" />
      </svg>
    )}
  </div>
  <div class="max-w-[15rem]">
    {premio.año && <div class="font-mono text-[.68rem] text-ochre tracking-[.04em]">{premio.año}</div>}
    <div class="font-serif text-[1.02rem] leading-tight mt-0.5">{premio.nombre}</div>
    {premio.sub && <div class="text-[.75rem] text-cream/55 mt-1">{premio.sub}</div>}
  </div>
</div>
