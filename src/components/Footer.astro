---
import { proyectosPropios } from '../data/contenido';
const año = new Date().getFullYear();
---

<footer class="border-t border-cream/10 mt-24">
  <div class="max-w-content mx-auto px-6 md:px-8 py-14 grid grid-cols-1 md:grid-cols-3 gap-10">
    <div>
      <div class="font-sans font-extrabold text-lg mb-3">Rocío Periago</div>
      <p class="text-sm text-cream/60 max-w-xs">
        Periodista freelance especializada en medio ambiente, migración y justicia social.
        Comunicación digital para ONGs y empresas. Codirectora de <a href="#" class="underline underline-offset-2 hover:text-cream transition-colors">Testeha Estudio</a>.
      </p>
    </div>

    <div>
      <div class="eyebrow-sage mb-3">Proyectos propios</div>
      <ul class="space-y-2 list-none">
        {proyectosPropios.map((p) => (
          <li>
            {p.url ? (
              <a href={p.url} target="_blank" rel="noopener" class="text-sm text-cream/70 hover:text-cream transition-colors">
                {p.nombre}
              </a>
            ) : (
              <span class="text-sm text-cream/70">{p.nombre}</span>
            )}
          </li>
        ))}
      </ul>
    </div>

    <div>
      <div class="eyebrow-sage mb-3">Contacto</div>
      <a href="mailto:hola@rocioperiago.com" class="text-sm text-cream/70 hover:text-cream transition-colors block mb-3">
        hola@rocioperiago.com
      </a>
      <div class="flex gap-4">
        <a href="https://linkedin.com/in/rocioperiago" target="_blank" rel="noopener" class="text-xs text-cream/50 hover:text-cream uppercase tracking-wide">LinkedIn</a>
        <a href="https://www.instagram.com/rocioperiago" target="_blank" rel="noopener" class="text-xs text-cream/50 hover:text-cream uppercase tracking-wide">Instagram</a>
      </div>
    </div>
  </div>

  <div class="border-t border-cream/10">
    <div class="max-w-content mx-auto px-6 md:px-8 py-5 flex flex-col md:flex-row justify-between gap-2 text-xs text-cream/40">
      <span>© {año} Rocío Periago — Diseño y desarrollo web Testeha Estudio</span>
      <div class="flex gap-5 font-mono">
        <a href="/politica-privacidad" class="hover:text-cream/70 transition-colors">Política de privacidad</a>
        <a href="/politica-cookies" class="hover:text-cream/70 transition-colors">Política de cookies</a>
        <a href="/aviso-legal" class="hover:text-cream/70 transition-colors">Aviso legal</a>
      </div>
    </div>
  </div>
</footer>
