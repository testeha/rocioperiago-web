---
const links = [
  { href: '/', label: 'Inicio' },
  { href: '/servicios', label: 'ONG y empresas' },
  { href: '/sobre-mi', label: 'Sobre mí' },
];
const submenuEditores = [
  { href: '/trabajos', label: 'Reportajes y artículos' },
  { href: '/investigaciones', label: 'Periodismo de investigación' },
];
const currentPath = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? currentPath === '/' : currentPath.startsWith(href));
const editoresActivo = submenuEditores.some((l) => isActive(l.href));
---

<nav id="site-nav" class="fixed top-0 inset-x-0 z-50 transition-colors duration-300">
  <div class="max-w-content mx-auto px-6 md:px-8 h-[76px] grid grid-cols-[1fr_auto_1fr] items-center">
    <a href="/" class="font-sans font-extrabold text-lg tracking-tight text-cream justify-self-start">Rocío Periago</a>

    <ul class="hidden md:flex gap-1 list-none bg-cream/10 border border-cream/15 rounded-full p-1 justify-self-center items-center">
      <li>
        <a
          href={links[0].href}
          class:list={[
            'block text-sm font-medium px-4 py-2 rounded-full transition-colors',
            isActive(links[0].href) ? 'bg-cream text-sea' : 'text-cream/75 hover:text-cream',
          ]}
        >
          {links[0].label}
        </a>
      </li>

      <li class="relative" id="editores-dropdown">
        <button
          id="editores-toggle"
          aria-expanded="false"
          class:list={[
            'flex items-center gap-1.5 text-sm font-medium px-4 py-2 rounded-full transition-colors',
            editoresActivo ? 'bg-cream text-sea' : 'text-cream/75 hover:text-cream',
          ]}
        >
          Editores y medios
          <svg id="editores-caret" width="10" height="10" viewBox="0 0 10 10" fill="none" class="transition-transform">
            <path d="M2 3.5L5 6.5L8 3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>

        <ul
          id="editores-submenu"
          class="hidden absolute top-[calc(100%+10px)] left-1/2 -translate-x-1/2 min-w-[220px] bg-sea border border-cream/15 rounded-2xl p-1.5 list-none shadow-xl shadow-black/30"
        >
          {submenuEditores.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[
                  'block text-sm px-4 py-2.5 rounded-xl whitespace-nowrap transition-colors',
                  isActive(link.href) ? 'bg-cream/10 text-cream font-medium' : 'text-cream/75 hover:bg-cream/5 hover:text-cream',
                ]}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </li>

      {links.slice(1).map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              'block text-sm font-medium px-4 py-2 rounded-full transition-colors',
              isActive(link.href) ? 'bg-cream text-sea' : 'text-cream/75 hover:text-cream',
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="justify-self-end flex items-center gap-3">
      <!-- Selector de idiomas: oculto por ahora, se activará más adelante -->
      <!-- <div class="hidden md:block font-mono text-xs tracking-wide text-cream/50 border border-cream/20 rounded-full px-3 py-1.5">ES · EN · IT</div> -->
      <a href="/contacto" class="hidden md:inline-block btn-ochre !rounded-full !py-2.5 !px-5 text-sm">Contactar</a>
      <button
        id="menu-toggle"
        class="md:hidden font-mono text-xs uppercase tracking-wide text-cream/80"
        aria-label="Abrir menú"
        aria-expanded="false"
      >
        Menú
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden md:hidden border-t border-cream/10 bg-sea">
    <ul class="flex flex-col px-6 py-4 gap-4 list-none">
      <li><a href={links[0].href} class="text-sm text-cream/80">{links[0].label}</a></li>

      <li>
        <div class="text-sm text-cream/50 font-mono text-xs uppercase tracking-wide mb-2">Editores y medios</div>
        <ul class="flex flex-col gap-3 pl-3 border-l border-cream/15 list-none">
          {submenuEditores.map((link) => (
            <li><a href={link.href} class="text-sm text-cream/80">{link.label}</a></li>
          ))}
        </ul>
      </li>

      {links.slice(1).map((link) => (
        <li><a href={link.href} class="text-sm text-cream/80">{link.label}</a></li>
      ))}
      <li><a href="/contacto" class="text-sm text-ochre">Contactar</a></li>
    </ul>
  </div>
</nav>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(isOpen));
  });

  // Header transparente sobre el hero; adquiere fondo al hacer scroll
  const nav = document.getElementById('site-nav');
  const SCROLL_THRESHOLD = 40;

  const updateNavBg = () => {
    if (!nav) return;
    if (window.scrollY > SCROLL_THRESHOLD) {
      nav.classList.add('bg-sea/95', 'backdrop-blur', 'border-b', 'border-cream/10');
    } else {
      nav.classList.remove('bg-sea/95', 'backdrop-blur', 'border-b', 'border-cream/10');
    }
  };

  updateNavBg();
  window.addEventListener('scroll', updateNavBg, { passive: true });

  // Desplegable "Editores y medios"
  const editoresToggle = document.getElementById('editores-toggle');
  const editoresSubmenu = document.getElementById('editores-submenu');
  const editoresCaret = document.getElementById('editores-caret');
  const editoresDropdown = document.getElementById('editores-dropdown');

  const cerrarSubmenu = () => {
    editoresSubmenu?.classList.add('hidden');
    editoresToggle?.setAttribute('aria-expanded', 'false');
    editoresCaret?.classList.remove('rotate-180');
  };

  editoresToggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    const abierto = !editoresSubmenu?.classList.contains('hidden');
    if (abierto) {
      cerrarSubmenu();
    } else {
      editoresSubmenu?.classList.remove('hidden');
      editoresToggle.setAttribute('aria-expanded', 'true');
      editoresCaret?.classList.add('rotate-180');
    }
  });

  document.addEventListener('click', (e) => {
    if (editoresDropdown && !editoresDropdown.contains(e.target as Node)) {
      cerrarSubmenu();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') cerrarSubmenu();
  });
</script>
