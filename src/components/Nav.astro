---
const links = [
  { href: '/', label: 'Inicio' },
  { href: '/trabajos', label: 'Trabajos' },
  { href: '/servicios', label: 'Servicios' },
  { href: '/sobre-mi', label: 'Sobre mí' },
];
const currentPath = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? currentPath === '/' : currentPath.startsWith(href));
---

<nav id="site-nav" class="fixed top-0 inset-x-0 z-50 transition-colors duration-300">
  <div class="max-w-content mx-auto px-6 md:px-8 h-[76px] grid grid-cols-[1fr_auto_1fr] items-center">
    <a href="/" class="font-serif italic text-lg tracking-tight text-cream justify-self-start">Rocío Periago</a>

    <ul class="hidden md:flex gap-1 list-none bg-cream/10 border border-cream/15 rounded-full p-1 justify-self-center">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              'block text-sm font-medium px-4 py-2 rounded-full transition-colors',
              isActive(link.href) ? 'bg-cream text-sea' : 'text-cream/75 hover:text-cream',
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="justify-self-end flex items-center gap-3">
      <!-- Selector de idiomas: oculto por ahora, se activará más adelante -->
      <!-- <div class="hidden md:block font-mono text-xs tracking-wide text-cream/50 border border-cream/20 rounded-full px-3 py-1.5">ES · EN · IT</div> -->
      <a href="/contacto" class="hidden md:inline-block btn-ochre !py-2.5 !px-5 text-sm">Contactar</a>
      <button
        id="menu-toggle"
        class="md:hidden font-mono text-xs uppercase tracking-wide text-cream/80"
        aria-label="Abrir menú"
        aria-expanded="false"
      >
        Menú
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden md:hidden border-t border-cream/10 bg-sea">
    <ul class="flex flex-col px-6 py-4 gap-4 list-none">
      {links.map((link) => (
        <li>
          <a href={link.href} class="text-sm text-cream/80">{link.label}</a>
        </li>
      ))}
      <li><a href="/contacto" class="text-sm text-ochre">Contactar</a></li>
    </ul>
  </div>
</nav>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(isOpen));
  });

  // Header transparente sobre el hero; adquiere fondo al hacer scroll
  const nav = document.getElementById('site-nav');
  const SCROLL_THRESHOLD = 40;

  const updateNavBg = () => {
    if (!nav) return;
    if (window.scrollY > SCROLL_THRESHOLD) {
      nav.classList.add('bg-sea/95', 'backdrop-blur', 'border-b', 'border-cream/10');
    } else {
      nav.classList.remove('bg-sea/95', 'backdrop-blur', 'border-b', 'border-cream/10');
    }
  };

  updateNavBg();
  window.addEventListener('scroll', updateNavBg, { passive: true });
</script>
