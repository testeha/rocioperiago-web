---
const links = [
  { href: '/', label: 'Inicio' },
  { href: '/trabajos', label: 'Trabajos' },
  { href: '/investigaciones', label: 'Investigaciones' },
  { href: '/servicios', label: 'Servicios' },
  { href: '/sobre-mi', label: 'Sobre mí' },
];
const currentPath = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? currentPath === '/' : currentPath.startsWith(href));
---

<nav class="border-b border-cream/10 sticky top-0 z-50 bg-sea/95 backdrop-blur">
  <div class="max-w-content mx-auto px-6 md:px-8 h-[64px] flex items-center justify-between">
    <a href="/" class="font-serif italic text-lg tracking-tight">Rocío Periago</a>

    <ul class="hidden md:flex gap-8 list-none">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              'text-[.72rem] uppercase tracking-[.06em] transition-colors',
              isActive(link.href) ? 'text-ochre' : 'text-cream/60 hover:text-cream',
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <a href="/contacto" class="btn-ochre !py-2 !px-4 text-xs">Contactar</a>

    <button
      id="menu-toggle"
      class="md:hidden font-mono text-xs uppercase tracking-wide text-cream/80"
      aria-label="Abrir menú"
      aria-expanded="false"
    >
      Menú
    </button>
  </div>

  <div id="mobile-menu" class="hidden md:hidden border-t border-cream/10 bg-sea">
    <ul class="flex flex-col px-6 py-4 gap-4 list-none">
      {links.map((link) => (
        <li>
          <a href={link.href} class="text-sm text-cream/80">{link.label}</a>
        </li>
      ))}
      <li><a href="/contacto" class="text-sm text-ochre">Contactar</a></li>
    </ul>
  </div>
</nav>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(isOpen));
  });
</script>
