---
import Layout from '../layouts/Layout.astro';
import { trabajos, temas } from '../data/trabajos';

const temaKeys = Object.keys(temas) as (keyof typeof temas)[];

// Patrón de filas para romper la monotonía visual del grid: fila de 3 columnas iguales,
// luego fila de 2 (una ancha 2/3 + una normal 1/3), y así sucesivamente.
// Si en una fila "ancha" no queda una segunda tarjeta para completarla, se deja normal
// (evita una tarjeta ancha huérfana, sin pareja que le marque la altura de fila).
function calcularAnchos(total: number): boolean[] {
  const anchos: boolean[] = [];
  let i = 0;
  let filaAncha = false; // empezamos con una fila normal de 3
  while (i < total) {
    if (filaAncha && total - i >= 2) {
      anchos.push(true, false); // primera tarjeta ancha, segunda normal
      i += 2;
    } else {
      const restantes = Math.min(3, total - i);
      for (let k = 0; k < restantes; k++) anchos.push(false);
      i += restantes;
    }
    filaAncha = !filaAncha;
  }
  return anchos;
}
const esAncha = calcularAnchos(trabajos.length);
---

<Layout
  title="Trabajos"
  description="Reportajes, crónicas e investigaciones de Rocío Periago publicados en El País, National Geographic, France 24, Altaïr Magazine y otros medios."
>
  <section class="max-w-content mx-auto px-6 md:px-8 pt-16 pb-8">
    <p class="eyebrow-ochre mb-3">Editores y medios</p>
    <h1 class="font-sans font-extrabold text-4xl md:text-5xl mb-4">Reportajes y artículos</h1>
    <p class="text-cream/70 max-w-xl">
      Aquí puedes leer algunos de mis reportajes y artículos publicados en medios.
      ¿Buscas los proyectos de investigación transfronteriza? Los tienes en <a href="/investigaciones" class="underline underline-offset-2 hover:text-cream transition-colors">Periodismo de investigación</a>.
    </p>
  </section>

  <!-- FILTROS -->
  <section class="max-w-content mx-auto px-6 md:px-8 pb-6">
    <p class="eyebrow-sage mb-4">Todo el portfolio</p>
    <div class="flex flex-wrap gap-2" id="filtros">
      <button data-filter="todos" class="filtro-btn is-active font-mono text-xs uppercase tracking-wide px-3 py-1.5 rounded-full border border-ochre bg-ochre text-sea">
        Todos
      </button>
      {temaKeys.map((key) => (
        <button
          data-filter={key}
          class="filtro-btn font-mono text-xs uppercase tracking-wide px-3 py-1.5 rounded-full border border-cream/25 text-cream/70 hover:border-cream/50"
        >
          {temas[key].label}
        </button>
      ))}
    </div>
  </section>

  <!-- GALERÍA -->
  <section class="max-w-content mx-auto px-6 md:px-8 pb-24">
    <div class="grid grid-cols-2 md:grid-cols-3 gap-4" id="lista-trabajos">
      {trabajos.map((t, i) => (
        <a
          href={t.url}
          target="_blank"
          rel="noopener"
          data-tema={t.tema}
          data-ancha={esAncha[i] ? 'true' : 'false'}
          class:list={[
            'trabajo-card group relative rounded-md overflow-hidden block',
            esAncha[i] ? 'col-span-2' : 'aspect-[4/5]',
            !t.imagen && 'bg-[repeating-linear-gradient(135deg,theme(colors.sea.3)_0px,theme(colors.sea.3)_2px,theme(colors.sea.2)_2px,theme(colors.sea.2)_4px)]',
          ]}
        >
          {t.imagen ? (
            <img src={t.imagen} alt={t.titulo} class="absolute inset-0 w-full h-full object-cover z-0" loading="lazy" />
          ) : (
            <span class="absolute top-3 left-3 font-mono text-[.55rem] uppercase tracking-wide text-cream/20 z-0">Foto pendiente</span>
          )}

          <!-- overlay oscuro, aparece al hover -->
          <div class="absolute inset-0 bg-[linear-gradient(to_top,rgba(0,0,0,.88)_0%,rgba(0,0,0,.6)_45%,rgba(0,0,0,.05)_75%,transparent_100%)] z-10"></div>
          <div class="absolute inset-0 bg-black/0 group-hover:bg-black/60 transition-colors duration-300 z-10"></div>

          <!-- contenido: título siempre visible, metadatos al hover -->
          <div class="absolute inset-0 z-20 flex flex-col justify-end p-4">
            {t.destacado && (
              <span class="self-start mb-2 text-[.55rem] font-mono uppercase tracking-wide bg-ochre text-sea px-1.5 py-0.5 rounded-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300">{t.destacado}</span>
            )}
            <span class="font-sans font-extrabold text-white text-base leading-tight drop-shadow-[0_2px_6px_rgba(0,0,0,.6)]">
              {t.titulo}
            </span>
            <span class="mt-2 font-mono text-[.75rem] font-medium uppercase tracking-wide text-cream/80 opacity-0 group-hover:opacity-100 transition-opacity duration-300 delay-75">
              {t.medio} · {t.año}
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- PROYECTOS PROPIOS -->
  <section class="border-t border-cream/10 bg-sea-2/30">
    <div class="max-w-content mx-auto px-6 md:px-8 py-16">
      <p class="flex items-center gap-2 mb-3">
        <span class="w-1.5 h-1.5 rounded-full bg-ochre inline-block"></span>
        <span class="kicker text-ochre-light">Ideas en acción</span>
      </p>
      <h2 class="font-sans font-extrabold text-3xl md:text-4xl mb-3">Proyectos propios</h2>
      <p class="text-cream/70 max-w-md mb-8">Iniciativas que nacen de la curiosidad, la creatividad y las ganas de generar un impacto positivo.</p>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <!-- 1. TESTEHA ESTUDIO -->
        <a
          href="https://testeha.com/"
          target="_blank"
          rel="noopener"
          style="--accent:#f7bd20"
          class="group relative flex flex-col min-h-[420px] p-7 rounded-lg border border-[color:var(--accent)]/40 border-t-2 border-t-[color:var(--accent)] bg-gradient-to-br from-cream/[.02] to-transparent hover:-translate-y-1 hover:border-[color:var(--accent)] transition-all duration-300"
        >
          <span aria-hidden="true" class="absolute top-4 right-5 text-2xl font-light text-[color:var(--accent)] transition-transform group-hover:translate-x-1 group-hover:-translate-y-1">↗</span>

          <div class="flex flex-col justify-center min-h-[80px] mb-3">
            <img src="/images/logos/testeha.png" alt="Testeha Estudio" class="h-8 w-auto object-contain object-left" />
          </div>

          <span class="block w-10 h-[3px] mb-5 bg-[color:var(--accent)]"></span>

          <p class="text-sm text-cream/80 leading-relaxed flex-1">Comunicación, estrategia y desarrollo web con un enfoque centrado en las personas.</p>

          <span class="mt-6 inline-flex items-center gap-3 text-sm font-semibold text-[color:var(--accent)]">
            Visitar proyecto
            <span aria-hidden="true" class="text-lg font-light transition-transform group-hover:translate-x-1 group-hover:-translate-y-1">↗</span>
          </span>
        </a>

        <!-- 2. ABRIENDO EL FOCO -->
        <a
          href="https://achalay.es/abriendoelfoco/"
          target="_blank"
          rel="noopener"
          style="--accent:#ff496c"
          class="group relative flex flex-col min-h-[420px] p-7 rounded-lg border border-[color:var(--accent)]/40 border-t-2 border-t-[color:var(--accent)] bg-gradient-to-br from-cream/[.02] to-transparent hover:-translate-y-1 hover:border-[color:var(--accent)] transition-all duration-300"
        >
          <span aria-hidden="true" class="absolute top-4 right-5 text-2xl font-light text-[color:var(--accent)] transition-transform group-hover:translate-x-1 group-hover:-translate-y-1">↗</span>

          <div class="flex flex-col justify-center min-h-[80px] mb-3">
            <img src="/images/logos/abriendo-el-foco.svg" alt="Abriendo el Foco" class="h-16 w-auto object-contain object-left" />
          </div>
          <span class="font-mono text-[.72rem] tracking-[.04em] text-[color:var(--accent)] mb-2 block">2025–2026</span>

          <span class="block w-10 h-[3px] mb-5 bg-[color:var(--accent)]"></span>

          <p class="text-sm text-cream/80 leading-relaxed flex-1">Podcasts sobre el tercer sector, realizados para Asociación Achalay.</p>

          <span class="mt-6 inline-flex items-center gap-3 text-sm font-semibold text-[color:var(--accent)]">
            Visitar proyecto
            <span aria-hidden="true" class="text-lg font-light transition-transform group-hover:translate-x-1 group-hover:-translate-y-1">↗</span>
          </span>
        </a>

        <!-- 3. JUNTOS CAMBIAMOS EL MUNDO -->
        <a
          href="https://juntoscambiamoselmundo.com"
          target="_blank"
          rel="noopener"
          style="--accent:#ff8a00"
          class="group relative flex flex-col min-h-[420px] p-7 rounded-lg border border-[color:var(--accent)]/40 border-t-2 border-t-[color:var(--accent)] bg-gradient-to-br from-cream/[.02] to-transparent hover:-translate-y-1 hover:border-[color:var(--accent)] transition-all duration-300"
        >
          <span aria-hidden="true" class="absolute top-4 right-5 text-2xl font-light text-[color:var(--accent)] transition-transform group-hover:translate-x-1 group-hover:-translate-y-1">↗</span>

          <div class="flex items-center justify-center w-14 h-14 rounded-full border border-[color:var(--accent)]/50 mb-3">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 21s-7.5-4.6-10-9.3C.5 8.2 2.4 4.5 6 4.5c2 0 3.3 1 4.5 2.3 1.5-1.5 2.6-2.3 4.5-2.3 3.6 0 5.5 3.7 4 7.2C19.5 16.4 12 21 12 21z" stroke="#ff8a00" stroke-width="1.6" stroke-linejoin="round"/>
            </svg>
          </div>
          <h3 class="font-sans font-extrabold text-lg leading-snug mb-1">Juntos Cambiamos el Mundo</h3>
          <span class="font-mono text-[.72rem] tracking-[.04em] text-[color:var(--accent)] mb-2 block">2019–2025</span>

          <span class="block w-10 h-[3px] mb-5 bg-[color:var(--accent)]"></span>

          <p class="text-sm text-cream/80 leading-relaxed flex-1">Historias y proyectos de personas que apuestan por el cambio social.</p>

          <span class="mt-6 inline-flex items-center gap-3 text-sm font-semibold text-[color:var(--accent)]">
            Visitar proyecto
            <span aria-hidden="true" class="text-lg font-light transition-transform group-hover:translate-x-1 group-hover:-translate-y-1">↗</span>
          </span>
        </a>

        <!-- 4. SOPLALEBECHE -->
        <a
          href="https://soplalebeche.com"
          target="_blank"
          rel="noopener"
          style="--accent:#96c95c"
          class="group relative flex flex-col min-h-[420px] p-7 rounded-lg border border-[color:var(--accent)]/40 border-t-2 border-t-[color:var(--accent)] bg-gradient-to-br from-cream/[.02] to-transparent hover:-translate-y-1 hover:border-[color:var(--accent)] transition-all duration-300"
        >
          <span aria-hidden="true" class="absolute top-4 right-5 text-2xl font-light text-[color:var(--accent)] transition-transform group-hover:translate-x-1 group-hover:-translate-y-1">↗</span>

          <div class="flex flex-col justify-center min-h-[80px] mb-3">
            <svg width="60" height="26" viewBox="0 0 60 26" fill="none" xmlns="http://www.w3.org/2000/svg" class="mb-1.5">
              <path d="M2 10 Q11 4 20 10 T37 10" stroke="#F7F4EC" stroke-width="1.8" stroke-linecap="round" fill="none"/>
              <path d="M2 16 Q9 12 16 16 T29 16" stroke="#F7F4EC" stroke-opacity="0.7" stroke-width="1.8" stroke-linecap="round" fill="none"/>
              <path d="M2 22 Q7 19.5 12 22" stroke="#F7F4EC" stroke-opacity="0.5" stroke-width="1.8" stroke-linecap="round" fill="none"/>
            </svg>
            <span class="font-serif text-2xl text-cream leading-none">Sopla<em class="not-italic italic">lebeche</em></span>
          </div>
          <span class="font-mono text-[.72rem] tracking-[.04em] text-[color:var(--accent)] mb-2 block">2014–2021</span>

          <span class="block w-10 h-[3px] mb-5 bg-[color:var(--accent)]"></span>

          <p class="text-sm text-cream/80 leading-relaxed flex-1">Blog de viajes y buenas historias con nombre de viento del sur.</p>

          <span class="mt-6 inline-flex items-center gap-3 text-sm font-semibold text-[color:var(--accent)]">
            Visitar proyecto
            <span aria-hidden="true" class="text-lg font-light transition-transform group-hover:translate-x-1 group-hover:-translate-y-1">↗</span>
          </span>
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filtro-btn');
  const cards = document.querySelectorAll<HTMLAnchorElement>('.trabajo-card');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => {
        b.classList.remove('is-active', 'bg-ochre', 'text-sea', 'border-ochre');
        b.classList.add('border-cream/25', 'text-cream/70');
      });
      btn.classList.add('is-active', 'bg-ochre', 'text-sea', 'border-ochre');
      btn.classList.remove('border-cream/25', 'text-cream/70');

      const filter = btn.dataset.filter;
      const esTodos = filter === 'todos';

      cards.forEach((card) => {
        const show = esTodos || card.dataset.tema === filter;
        card.style.display = show ? '' : 'none';

        // El patrón de filas 3/2 solo tiene sentido viendo todos los trabajos en su orden
        // original; al filtrar por tema, volvemos a una rejilla simple y uniforme.
        const eraAncha = card.dataset.ancha === 'true';
        if (esTodos && eraAncha) {
          card.classList.add('col-span-2');
          card.classList.remove('aspect-[4/5]');
        } else {
          card.classList.remove('col-span-2');
          card.classList.add('aspect-[4/5]');
        }
      });
    });
  });
</script>
