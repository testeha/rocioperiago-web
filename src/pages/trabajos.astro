---
import Layout from '../layouts/Layout.astro';
import { trabajos, temas } from '../data/trabajos';

const temaKeys = Object.keys(temas) as (keyof typeof temas)[];

// Patrón de filas para romper la monotonía visual del grid: fila de 3 columnas iguales,
// luego fila de 2 (una ancha 2/3 + una normal 1/3), y así sucesivamente.
// Si en una fila "ancha" no queda una segunda tarjeta para completarla, se deja normal
// (evita una tarjeta ancha huérfana, sin pareja que le marque la altura de fila).
function calcularAnchos(total: number): boolean[] {
  const anchos: boolean[] = [];
  let i = 0;
  let filaAncha = false; // empezamos con una fila normal de 3
  while (i < total) {
    if (filaAncha && total - i >= 2) {
      anchos.push(true, false); // primera tarjeta ancha, segunda normal
      i += 2;
    } else {
      const restantes = Math.min(3, total - i);
      for (let k = 0; k < restantes; k++) anchos.push(false);
      i += restantes;
    }
    filaAncha = !filaAncha;
  }
  return anchos;
}
const esAncha = calcularAnchos(trabajos.length);
---

<Layout
  title="Trabajos"
  description="Reportajes, crónicas e investigaciones de Rocío Periago publicados en El País, National Geographic, France 24, Altaïr Magazine y otros medios."
>
  <section class="max-w-content mx-auto px-6 md:px-8 pt-16 pb-8">
    <p class="eyebrow-ochre mb-3">Editores y medios</p>
    <h1 class="font-sans font-extrabold text-4xl md:text-5xl mb-4">Reportajes y artículos</h1>
    <p class="text-cream/70 max-w-xl">
      Aquí puedes leer algunos de mis reportajes y artículos publicados en medios.
      ¿Buscas los proyectos de investigación transfronteriza? Los tienes en <a href="/investigaciones" class="underline underline-offset-2 hover:text-cream transition-colors">Periodismo de investigación</a>.
    </p>
  </section>

  <!-- FILTROS -->
  <section class="max-w-content mx-auto px-6 md:px-8 pb-6">
    <p class="eyebrow-sage mb-4">Todo el portfolio</p>
    <div class="flex flex-wrap gap-2" id="filtros">
      <button data-filter="todos" class="filtro-btn is-active font-mono text-xs uppercase tracking-wide px-3 py-1.5 rounded-full border border-ochre bg-ochre text-sea">
        Todos
      </button>
      {temaKeys.map((key) => (
        <button
          data-filter={key}
          class="filtro-btn font-mono text-xs uppercase tracking-wide px-3 py-1.5 rounded-full border border-cream/25 text-cream/70 hover:border-cream/50"
        >
          {temas[key].label}
        </button>
      ))}
    </div>
  </section>

  <!-- GALERÍA -->
  <section class="max-w-content mx-auto px-6 md:px-8 pb-24">
    <div class="grid grid-cols-2 md:grid-cols-3 gap-4" id="lista-trabajos">
      {trabajos.map((t, i) => (
        <a
          href={t.url}
          target="_blank"
          rel="noopener"
          data-tema={t.tema}
          data-ancha={esAncha[i] ? 'true' : 'false'}
          class:list={[
            'trabajo-card group relative rounded-md overflow-hidden block',
            esAncha[i] ? 'col-span-2' : 'aspect-[4/5]',
            !t.imagen && 'bg-[repeating-linear-gradient(135deg,theme(colors.sea.3)_0px,theme(colors.sea.3)_2px,theme(colors.sea.2)_2px,theme(colors.sea.2)_4px)]',
          ]}
        >
          {t.imagen ? (
            <img src={t.imagen} alt={t.titulo} class="absolute inset-0 w-full h-full object-cover z-0" loading="lazy" />
          ) : (
            <span class="absolute top-3 left-3 font-mono text-[.55rem] uppercase tracking-wide text-cream/20 z-0">Foto pendiente</span>
          )}

          <!-- overlay oscuro, aparece al hover -->
          <div class="absolute inset-0 bg-[linear-gradient(to_top,rgba(0,0,0,.88)_0%,rgba(0,0,0,.6)_45%,rgba(0,0,0,.05)_75%,transparent_100%)] z-10"></div>
          <div class="absolute inset-0 bg-black/0 group-hover:bg-black/60 transition-colors duration-300 z-10"></div>

          <!-- contenido: título siempre visible, metadatos al hover -->
          <div class="absolute inset-0 z-20 flex flex-col justify-end p-4">
            {t.destacado && (
              <span class="self-start mb-2 text-[.55rem] font-mono uppercase tracking-wide bg-ochre text-sea px-1.5 py-0.5 rounded-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300">{t.destacado}</span>
            )}
            <span class="font-sans font-extrabold text-white text-base leading-tight drop-shadow-[0_2px_6px_rgba(0,0,0,.6)]">
              {t.titulo}
            </span>
            <span class="mt-2 font-mono text-[.75rem] font-medium uppercase tracking-wide text-cream/80 opacity-0 group-hover:opacity-100 transition-opacity duration-300 delay-75">
              {t.medio} · {t.año}
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="max-w-content mx-auto px-6 md:px-8 pb-24">
    <div class="bg-sea-2 rounded-md p-10 md:p-14 flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div>
        <h2 class="font-sans font-extrabold text-2xl md:text-3xl mb-2">¿Tienes una historia que contar?</h2>
        <p class="text-cream/65">Si eres editor o editora y buscas colaboraciones, hablemos.</p>
      </div>
      <a href="/contacto" class="btn-sage flex-shrink-0">Contactar</a>
    </div>
  </section>
</Layout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filtro-btn');
  const cards = document.querySelectorAll<HTMLAnchorElement>('.trabajo-card');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => {
        b.classList.remove('is-active', 'bg-ochre', 'text-sea', 'border-ochre');
        b.classList.add('border-cream/25', 'text-cream/70');
      });
      btn.classList.add('is-active', 'bg-ochre', 'text-sea', 'border-ochre');
      btn.classList.remove('border-cream/25', 'text-cream/70');

      const filter = btn.dataset.filter;
      const esTodos = filter === 'todos';

      cards.forEach((card) => {
        const show = esTodos || card.dataset.tema === filter;
        card.style.display = show ? '' : 'none';

        // El patrón de filas 3/2 solo tiene sentido viendo todos los trabajos en su orden
        // original; al filtrar por tema, volvemos a una rejilla simple y uniforme.
        const eraAncha = card.dataset.ancha === 'true';
        if (esTodos && eraAncha) {
          card.classList.add('col-span-2');
          card.classList.remove('aspect-[4/5]');
        } else {
          card.classList.remove('col-span-2');
          card.classList.add('aspect-[4/5]');
        }
      });
    });
  });
</script>
