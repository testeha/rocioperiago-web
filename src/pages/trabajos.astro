---
import Layout from '../layouts/Layout.astro';
import MapaMundi from '../components/MapaMundi.astro';
import { trabajos, temas } from '../data/trabajos';
import { proyectosPropios } from '../data/contenido';

const temaKeys = Object.keys(temas) as (keyof typeof temas)[];

const investigacionesDestacadas = [
  {
    titulo: 'El polvillo que contamina el mundo: la ruta del carbón Colombia–Alemania',
    url: 'https://www.journalismfund.eu/coal-route',
    resumen:
      'El impacto humano, social y ambiental del carbón extraído en La Guajira colombiana y consumido en centrales alemanas. Investigación transfronteriza sobre cadenas de suministro, comunidades afectadas y transición energética. Proyecto realizado durante 2023 y 2024 con la financiación de JournalismFund Europe junto con G. Jaramillo Rojas y Anita Pouchard Serra.',
    publicadoEn: 'Público, Espacio Angular, Brecha, Revista Late',
    presentadoEn: null,
  },
  {
    titulo: 'The not-so-sunny side of sunscreen',
    url: 'https://www.journalismfund.eu/not-so-sunny-side-of-sunscreen',
    resumen:
      'Los filtros solares contaminan el Mediterráneo. Investigación y entrevistas a científicos, investigadores y activistas en España e Italia, y cobertura en medios internacionales. Proyecto realizado durante 2024 y 2025 con la financiación de JournalismFund Europe junto con Cush Munger.',
    publicadoEn: 'Revista Late, France 24, Revolve, Inside Story',
    presentadoEn: { texto: 'DIG Festival', url: 'https://dig-awards.org/eng/', resto: '(2025) en Modena, Italia.' },
  },
];

const pinesMapa = [
  {
    codigo: 'co',
    nombre: 'Colombia',
    left: 25.97,
    top: 55.97,
    kicker: 'Journalismfund Europe · 2023',
    titulo: 'El polvillo que contamina el mundo: la ruta del carbón',
    url: 'https://www.journalismfund.eu/coal-route',
    cta: 'Leer investigación',
  },
  {
    codigo: 'de',
    nombre: 'Alemania',
    left: 49.93,
    top: 31.1,
    kicker: 'Journalismfund Europe · 2023',
    titulo: 'El polvillo que contamina el mundo: la ruta del carbón',
    url: 'https://www.journalismfund.eu/coal-route',
    cta: 'Leer investigación',
  },
  {
    codigo: 'es',
    nombre: 'España',
    left: 47.42,
    top: 38.1,
    kicker: 'Revista Late · 2023',
    titulo: 'El Mar Menor, una laguna salada que lucha por sobrevivir',
    url: 'https://www.revistalate.net/el-mar-menor-una-laguna-salada-que-lucha-por-sobrevivir/',
    cta: 'Leer artículo',
  },
  {
    codigo: 'it',
    nombre: 'Italia',
    left: 50.06,
    top: 36.59,
    kicker: 'Journalismfund Europe · 2025',
    titulo: 'The not-so-sunny side of sunscreen',
    url: 'https://www.journalismfund.eu/not-so-sunny-side-of-sunscreen',
    cta: 'Leer investigación',
  },
  {
    codigo: 'tr',
    nombre: 'Turquía',
    left: 56.38,
    top: 39.31,
    kicker: 'Altaïr Magazine · 2020',
    titulo: 'La biblioteca de las mujeres de Estambul',
    url: 'https://www.altairmagazine.com/voces/la-biblioteca-de-las-mujeres/',
    cta: 'Leer artículo',
  },
  {
    codigo: 'br',
    nombre: 'Brasil',
    left: 32.63,
    top: 82.17,
    kicker: 'El País · 2016',
    titulo: 'De las calles de Recife a los fogones',
    url: 'https://elpais.com/elpais/2016/11/29/planeta_futuro/1480440360_379651.html',
    cta: 'Leer artículo',
  },
];
---

<Layout
  title="Trabajos"
  description="Reportajes, crónicas e investigaciones de Rocío Periago publicados en El País, National Geographic, France 24, Altaïr Magazine y otros medios."
>
  <section class="max-w-content mx-auto px-6 md:px-8 pt-16 pb-8">
    <p class="eyebrow-ochre mb-3">Portfolio</p>
    <h1 class="font-sans font-extrabold text-4xl md:text-5xl mb-4">Trabajos publicados</h1>
    <p class="text-cream/70 max-w-xl">
      Reportajes y crónicas sobre medio ambiente, migración, justicia social y viajes,
      publicados en medios nacionales e internacionales desde 2012.
    </p>
  </section>

  <!-- PERIODISMO DE INVESTIGACIÓN -->
  <section class="max-w-content mx-auto px-6 md:px-8 pb-16">
    <p class="eyebrow-ochre mb-3">Periodismo de investigación</p>
    <h2 class="font-sans font-extrabold text-2xl md:text-3xl mb-8">Proyectos de largo aliento transfronterizos</h2>

    <div class="mb-10">
      <MapaMundi pines={pinesMapa} />
    </div>
    <div class="grid md:grid-cols-2 gap-5">
      {investigacionesDestacadas.map((inv, i) => (
        <div class:list={['rounded-xl p-8 md:p-10', i % 2 === 0 ? 'bg-ochre' : 'bg-sea-2']}>
          <span class:list={['block font-mono uppercase mb-4 font-medium', i % 2 === 0 ? 'text-sea' : 'text-ochre-light']} style="font-size:0.72rem; letter-spacing:0.4px;">
            Journalismfund Europe
          </span>
          <a
            href={inv.url}
            target="_blank"
            rel="noopener"
            class:list={['font-sans font-extrabold text-xl leading-snug transition-colors block mb-4', i % 2 === 0 ? 'text-sea hover:text-sea/70' : 'text-cream hover:text-ochre-light']}
          >
            {inv.titulo}
          </a>
          <p class:list={['text-sm leading-relaxed mb-5', i % 2 === 0 ? 'text-sea' : 'text-cream/70']}>{inv.resumen}</p>
          <p class:list={['text-xs leading-relaxed', i % 2 === 0 ? 'text-sea' : 'text-cream/55']}>
            <strong class:list={i % 2 === 0 ? 'text-sea' : 'text-cream'}>Publicado en</strong> {inv.publicadoEn}
            {inv.presentadoEn && (
              <>
                <br />
                <strong class:list={i % 2 === 0 ? 'text-sea' : 'text-cream'}>Presentado en</strong> el <a href={inv.presentadoEn.url} target="_blank" rel="noopener" class="underline underline-offset-2 hover:opacity-70">{inv.presentadoEn.texto}</a> {inv.presentadoEn.resto}
              </>
            )}
          </p>
        </div>
      ))}
    </div>
  </section>

  <!-- FILTROS -->
  <section class="max-w-content mx-auto px-6 md:px-8 pb-6">
    <p class="eyebrow-sage mb-4">Todo el portfolio</p>
    <div class="flex flex-wrap gap-2" id="filtros">
      <button data-filter="todos" class="filtro-btn is-active font-mono text-xs uppercase tracking-wide px-3 py-1.5 rounded-full border border-ochre bg-ochre text-sea">
        Todos
      </button>
      {temaKeys.map((key) => (
        <button
          data-filter={key}
          class="filtro-btn font-mono text-xs uppercase tracking-wide px-3 py-1.5 rounded-full border border-cream/25 text-cream/70 hover:border-cream/50"
        >
          {temas[key].label}
        </button>
      ))}
    </div>
  </section>

  <!-- GALERÍA -->
  <section class="max-w-content mx-auto px-6 md:px-8 pb-24">
    <div class="grid grid-cols-2 md:grid-cols-3 gap-4" id="lista-trabajos">
      {trabajos.map((t) => (
        <a
          href={t.url}
          target="_blank"
          rel="noopener"
          data-tema={t.tema}
          class:list={[
            'trabajo-card group relative aspect-[4/5] rounded-md overflow-hidden block',
            !t.imagen && 'bg-[repeating-linear-gradient(135deg,theme(colors.sea.3)_0px,theme(colors.sea.3)_2px,theme(colors.sea.2)_2px,theme(colors.sea.2)_4px)]',
          ]}
        >
          {t.imagen ? (
            <img src={t.imagen} alt={t.titulo} class="absolute inset-0 w-full h-full object-cover z-0" loading="lazy" />
          ) : (
            <span class="absolute top-3 left-3 font-mono text-[.55rem] uppercase tracking-wide text-cream/20 z-0">Foto pendiente</span>
          )}

          <!-- overlay oscuro, aparece al hover -->
          <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/10 to-transparent z-10"></div>
          <div class="absolute inset-0 bg-black/0 group-hover:bg-black/60 transition-colors duration-300 z-10"></div>

          <!-- contenido: título siempre visible, metadatos al hover -->
          <div class="absolute inset-0 z-20 flex flex-col justify-end p-4">
            {t.destacado && (
              <span class="self-start mb-2 text-[.55rem] font-mono uppercase tracking-wide bg-ochre text-sea px-1.5 py-0.5 rounded-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300">{t.destacado}</span>
            )}
            <span class="font-sans font-extrabold text-white text-base leading-tight drop-shadow-[0_2px_6px_rgba(0,0,0,.6)]">
              {t.titulo}
            </span>
            <span class="mt-2 font-mono text-[.75rem] font-medium uppercase tracking-wide text-cream/80 opacity-0 group-hover:opacity-100 transition-opacity duration-300 delay-75">
              {t.medio} · {t.año}
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- PROYECTOS PROPIOS -->
  <section class="border-t border-cream/10 bg-sea-2/30">
    <div class="max-w-content mx-auto px-6 md:px-8 py-16">
      <p class="eyebrow-sage mb-3">Fuera de la redacción</p>
      <h2 class="font-sans font-extrabold text-2xl md:text-3xl mb-8">Proyectos propios</h2>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {proyectosPropios.map((p) =>
          p.url ? (
            <a href={p.url} target="_blank" rel="noopener" class="group block bg-sea-2 rounded-md p-6 hover:bg-sea-3 transition-colors">
              {p.años && <div class="font-mono text-[.68rem] text-sage tracking-[.04em] mb-2">{p.años}</div>}
              <div class="font-sans font-extrabold text-lg leading-snug mb-1.5 group-hover:text-ochre transition-colors">{p.nombre}</div>
              <div class="text-sm text-cream/55">{p.formato}</div>
            </a>
          ) : (
            <div class="bg-sea-2 rounded-md p-6">
              {p.años && <div class="font-mono text-[.68rem] text-sage tracking-[.04em] mb-2">{p.años}</div>}
              <div class="font-sans font-extrabold text-lg leading-snug mb-1.5">{p.nombre}</div>
              <div class="text-sm text-cream/55">{p.formato}</div>
            </div>
          )
        )}
      </div>
    </div>
  </section>
</Layout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filtro-btn');
  const cards = document.querySelectorAll<HTMLAnchorElement>('.trabajo-card');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => {
        b.classList.remove('is-active', 'bg-ochre', 'text-sea', 'border-ochre');
        b.classList.add('border-cream/25', 'text-cream/70');
      });
      btn.classList.add('is-active', 'bg-ochre', 'text-sea', 'border-ochre');
      btn.classList.remove('border-cream/25', 'text-cream/70');

      const filter = btn.dataset.filter;
      cards.forEach((card) => {
        const show = filter === 'todos' || card.dataset.tema === filter;
        card.style.display = show ? '' : 'none';
      });
    });
  });
</script>
