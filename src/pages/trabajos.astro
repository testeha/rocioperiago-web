---
import Layout from '../layouts/Layout.astro';
import { trabajos, temas } from '../data/trabajos';
import { proyectosPropios } from '../data/contenido';

const temaKeys = Object.keys(temas) as (keyof typeof temas)[];

const investigacionesDestacadas = [
  {
    titulo: 'El polvillo que contamina el mundo: la ruta del carbón Colombia–Alemania',
    url: 'https://www.journalismfund.eu/coal-route',
    resumen:
      'El impacto humano, social y ambiental del carbón extraído en La Guajira colombiana y consumido en centrales alemanas. Investigación transfronteriza sobre cadenas de suministro, comunidades afectadas y transición energética. Proyecto realizado durante 2023 y 2024 con la financiación de JournalismFund Europe junto con G. Jaramillo Rojas y Anita Pouchard Serra.',
    publicadoEn: 'Público, Espacio Angular, Brecha, Revista Late',
    presentadoEn: null,
  },
  {
    titulo: 'The not-so-sunny side of sunscreen',
    url: 'https://www.journalismfund.eu/not-so-sunny-side-of-sunscreen',
    resumen:
      'Los filtros solares contaminan el Mediterráneo. Investigación y entrevistas a científicos, investigadores y activistas en España e Italia, y cobertura en medios internacionales. Proyecto realizado durante 2024 y 2025 con la financiación de JournalismFund Europe junto con Cush Munger.',
    publicadoEn: 'Revista Late, France 24, Revolve, Inside Story',
    presentadoEn: { texto: 'DIG Festival', url: 'https://dig-awards.org/eng/', resto: '(2025) en Modena, Italia.' },
  },
];
---

<Layout
  title="Trabajos"
  description="Reportajes, crónicas e investigaciones de Rocío Periago publicados en El País, National Geographic, France 24, Altaïr Magazine y otros medios."
>
  <section class="max-w-content mx-auto px-6 md:px-8 pt-16 pb-8">
    <p class="eyebrow-ochre mb-3">Portfolio</p>
    <h1 class="font-serif text-4xl md:text-5xl mb-4">Trabajos publicados</h1>
    <p class="text-cream/70 max-w-xl">
      Reportajes y crónicas sobre medio ambiente, migración, justicia social y viajes,
      publicados en medios nacionales e internacionales desde 2012.
    </p>
  </section>

  <!-- PERIODISMO DE INVESTIGACIÓN -->
  <section class="max-w-content mx-auto px-6 md:px-8 pb-16">
    <p class="eyebrow-ochre mb-3">Periodismo de investigación</p>
    <h2 class="font-serif text-2xl md:text-3xl mb-8">Proyectos de largo aliento transfronterizos</h2>

    <div class="grid md:grid-cols-2 gap-5">
      {investigacionesDestacadas.map((inv) => (
        <div class="card-sand rounded-md p-7 md:p-8">
          <a href={inv.url} target="_blank" rel="noopener" class="font-serif text-xl leading-snug hover:text-sea/70 transition-colors underline decoration-ochre/40 underline-offset-4">
            {inv.titulo}
          </a>
          <p class="text-sm text-ink/75 mt-4 leading-relaxed">{inv.resumen}</p>
          <p class="text-xs text-ink/55 mt-4">
            Publicado en {inv.publicadoEn}
            {inv.presentadoEn && (
              <>
                <br />
                Presentado en el <a href={inv.presentadoEn.url} target="_blank" rel="noopener" class="underline decoration-ochre/40 underline-offset-2 hover:text-ink">{inv.presentadoEn.texto}</a> {inv.presentadoEn.resto}
              </>
            )}
          </p>
        </div>
      ))}
    </div>
  </section>

  <!-- FILTROS -->
  <section class="max-w-content mx-auto px-6 md:px-8 pb-6">
    <p class="eyebrow-sage mb-4">Todo el portfolio</p>
    <div class="flex flex-wrap gap-2" id="filtros">
      <button data-filter="todos" class="filtro-btn is-active font-mono text-xs uppercase tracking-wide px-3 py-1.5 rounded-full border border-ochre bg-ochre text-sea">
        Todos
      </button>
      {temaKeys.map((key) => (
        <button
          data-filter={key}
          class="filtro-btn font-mono text-xs uppercase tracking-wide px-3 py-1.5 rounded-full border border-cream/25 text-cream/70 hover:border-cream/50"
        >
          {temas[key].label}
        </button>
      ))}
    </div>
  </section>

  <!-- TABLA / LISTA -->
  <section class="max-w-content mx-auto px-6 md:px-8 pb-24">
    <div class="border-t border-cream/10" id="lista-trabajos">
      {trabajos.map((t) => (
        <a
          href={t.url}
          target="_blank"
          rel="noopener"
          data-tema={t.tema}
          class="trabajo-row group flex flex-col md:flex-row md:items-center gap-1.5 md:gap-6 py-5 border-b border-cream/10 hover:bg-sea-2/40 transition-colors px-2 -mx-2"
        >
          <span class="font-mono text-[.68rem] uppercase text-sage w-full md:w-40 flex-shrink-0">{t.medio}</span>
          <span class="font-serif text-lg flex-1 group-hover:text-ochre transition-colors">
            {t.titulo}
            {t.destacado && (
              <span class="ml-2 align-middle text-[.6rem] font-mono uppercase tracking-wide bg-ochre/20 text-ochre px-1.5 py-0.5 rounded-sm">{t.destacado}</span>
            )}
          </span>
          <span class="text-xs text-cream/45 flex-shrink-0 w-32">{t.temaLabel}</span>
          <span class="font-mono text-xs text-cream/40 flex-shrink-0 w-14">{t.año}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- PROYECTOS PROPIOS -->
  <section class="border-t border-cream/10 bg-sea-2/30">
    <div class="max-w-content mx-auto px-6 md:px-8 py-16">
      <p class="eyebrow-sage mb-3">Fuera de la redacción</p>
      <h2 class="font-serif text-2xl md:text-3xl mb-8">Proyectos propios</h2>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {proyectosPropios.map((p) =>
          p.url ? (
            <a href={p.url} target="_blank" rel="noopener" class="group block bg-sea-2 rounded-md p-6 hover:bg-sea-3 transition-colors">
              {p.años && <div class="font-mono text-[.68rem] text-sage tracking-[.04em] mb-2">{p.años}</div>}
              <div class="font-serif text-lg leading-snug mb-1.5 group-hover:text-ochre transition-colors">{p.nombre}</div>
              <div class="text-sm text-cream/55">{p.formato}</div>
            </a>
          ) : (
            <div class="bg-sea-2 rounded-md p-6">
              {p.años && <div class="font-mono text-[.68rem] text-sage tracking-[.04em] mb-2">{p.años}</div>}
              <div class="font-serif text-lg leading-snug mb-1.5">{p.nombre}</div>
              <div class="text-sm text-cream/55">{p.formato}</div>
            </div>
          )
        )}
      </div>
    </div>
  </section>
</Layout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filtro-btn');
  const rows = document.querySelectorAll<HTMLAnchorElement>('.trabajo-row');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => {
        b.classList.remove('is-active', 'bg-ochre', 'text-sea', 'border-ochre');
        b.classList.add('border-cream/25', 'text-cream/70');
      });
      btn.classList.add('is-active', 'bg-ochre', 'text-sea', 'border-ochre');
      btn.classList.remove('border-cream/25', 'text-cream/70');

      const filter = btn.dataset.filter;
      rows.forEach((row) => {
        const show = filter === 'todos' || row.dataset.tema === filter;
        row.style.display = show ? '' : 'none';
      });
    });
  });
</script>
