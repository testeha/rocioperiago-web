---
import Layout from '../layouts/Layout.astro';
import { titular } from '../data/legal';
---

<Layout
  title="Contacto"
  description="Escribe directamente a Rocío Periago para proponer un encargo editorial, una colaboración o un proyecto de comunicación. Sin formularios."
>
  <section class="max-w-content mx-auto px-6 md:px-8 pt-16 pb-8">
    <p class="eyebrow-ochre mb-3">Hablemos</p>
    <h1 class="font-serif text-6xl md:text-8xl leading-[0.95] mb-4">Contacto</h1>
    <p class="text-cream/70 max-w-xl mb-6">Periodismo, comunicación y proyectos con impacto social.</p>
    <span class="block w-10 h-[3px] bg-ochre"></span>
  </section>

  <section class="max-w-content mx-auto px-6 md:px-8 pb-16">
    <h2 class="font-serif text-3xl md:text-5xl leading-tight max-w-2xl mb-8">
      ¿Tienes una historia, un proyecto o <span class="italic text-sage">algo que contarme?</span>
    </h2>
    <p class="text-cream/70 max-w-xl mb-14">
      Para encargos periodísticos, colaboraciones, proyectos de comunicación o cualquier otra consulta, escríbeme
      directamente. No hace falta formulario.
    </p>

    <div class="border-t border-cream/10 pt-10 pb-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div>
        <p class="kicker text-sage mb-2">Escríbeme</p>
        <a
          href={`mailto:${titular.email}`}
          class="font-serif text-3xl md:text-5xl break-all hover:text-ochre-light transition-colors"
        >
          {titular.email}
        </a>
      </div>
      <a
        href={`mailto:${titular.email}`}
        aria-label={`Escribir a ${titular.email}`}
        class="flex-shrink-0 w-16 h-16 rounded-full border border-cream/30 flex items-center justify-center text-2xl font-light hover:border-cream/60 hover:text-ochre-light transition-colors"
      >
        <span aria-hidden="true">↗</span>
      </a>
    </div>

    <div class="border-t border-cream/10 pt-6 flex flex-col md:flex-row md:items-center justify-between gap-3">
      <p class="text-sm text-cream/50">Contacto directo · sin formularios</p>
      <div class="flex gap-6">
        <a href="https://linkedin.com/in/rocioperiago" target="_blank" rel="noopener" class="text-sm text-cream/60 hover:text-cream transition-colors">LinkedIn</a>
        <a href="https://www.instagram.com/rocioperiago" target="_blank" rel="noopener" class="text-sm text-cream/60 hover:text-cream transition-colors">Instagram</a>
        <a href="#" class="text-sm text-cream/60 hover:text-cream transition-colors">Twitter/X</a>
      </div>
    </div>
  </section>
</Layout>
