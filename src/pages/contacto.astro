---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contacto"
  description="Contacta con Rocío Periago para proponer un encargo editorial o pedir presupuesto de comunicación digital para tu organización."
>
  <section class="max-w-content mx-auto px-6 md:px-8 pt-16 pb-10">
    <p class="eyebrow-ochre mb-3">Hablemos</p>
    <h1 class="font-sans font-extrabold text-4xl md:text-5xl mb-4">Contacto</h1>
    <p class="text-cream/70 max-w-xl">
      Cuéntame en qué estás trabajando. Respondo en menos de 48 horas.
    </p>
  </section>

  <section class="max-w-content mx-auto px-6 md:px-8 pb-16">
    <div class="grid md:grid-cols-2 gap-4">
      <!-- EDITORES -->
      <div class="bg-sea-2 rounded-md p-8 md:p-10 border-t-[3px] border-ochre">
        <p class="eyebrow-ochre mb-3">Para editores y medios</p>
        <h2 class="font-sans font-extrabold text-2xl mb-4">Proponer un encargo</h2>
        <p class="text-sm text-cream/65 mb-6">
          Reportajes, investigaciones o crónicas. Trabajo con plazos claros y coordinación directa.
        </p>
        <form class="space-y-4" data-audience="editor">
          <div>
            <label for="nombre-editor" class="block text-xs font-mono uppercase tracking-wide text-cream/50 mb-1.5">Nombre</label>
            <input id="nombre-editor" name="nombre" type="text" required class="w-full bg-sea border border-cream/20 rounded-sm px-3 py-2.5 text-sm focus-visible:outline-none focus-visible:border-ochre" />
          </div>
          <div>
            <label for="medio" class="block text-xs font-mono uppercase tracking-wide text-cream/50 mb-1.5">Medio</label>
            <input id="medio" name="medio" type="text" class="w-full bg-sea border border-cream/20 rounded-sm px-3 py-2.5 text-sm focus-visible:outline-none focus-visible:border-ochre" />
          </div>
          <div>
            <label for="email-editor" class="block text-xs font-mono uppercase tracking-wide text-cream/50 mb-1.5">Email</label>
            <input id="email-editor" name="email" type="email" required class="w-full bg-sea border border-cream/20 rounded-sm px-3 py-2.5 text-sm focus-visible:outline-none focus-visible:border-ochre" />
          </div>
          <div>
            <label for="mensaje-editor" class="block text-xs font-mono uppercase tracking-wide text-cream/50 mb-1.5">Mensaje</label>
            <textarea id="mensaje-editor" name="mensaje" rows="4" required class="w-full bg-sea border border-cream/20 rounded-sm px-3 py-2.5 text-sm focus-visible:outline-none focus-visible:border-ochre"></textarea>
          </div>
          <button type="submit" class="btn-ochre w-full">Proponer encargo</button>
        </form>
      </div>

      <!-- ORGANIZACIONES -->
      <div class="bg-sea-2 rounded-md p-8 md:p-10 border-t-[3px] border-sage">
        <p class="eyebrow-sage mb-3">Para ONGs y empresas con valores</p>
        <h2 class="font-sans font-extrabold text-2xl mb-4">Pedir presupuesto</h2>
        <p class="text-sm text-cream/65 mb-6">
          Estrategia de comunicación, redacción, podcast o gestión de redes. Cuéntame tu proyecto.
        </p>
        <form class="space-y-4" data-audience="org">
          <div>
            <label for="nombre-org" class="block text-xs font-mono uppercase tracking-wide text-cream/50 mb-1.5">Nombre</label>
            <input id="nombre-org" name="nombre" type="text" required class="w-full bg-sea border border-cream/20 rounded-sm px-3 py-2.5 text-sm focus-visible:outline-none focus-visible:border-sage" />
          </div>
          <div>
            <label for="organizacion" class="block text-xs font-mono uppercase tracking-wide text-cream/50 mb-1.5">Organización</label>
            <input id="organizacion" name="organizacion" type="text" class="w-full bg-sea border border-cream/20 rounded-sm px-3 py-2.5 text-sm focus-visible:outline-none focus-visible:border-sage" />
          </div>
          <div>
            <label for="email-org" class="block text-xs font-mono uppercase tracking-wide text-cream/50 mb-1.5">Email</label>
            <input id="email-org" name="email" type="email" required class="w-full bg-sea border border-cream/20 rounded-sm px-3 py-2.5 text-sm focus-visible:outline-none focus-visible:border-sage" />
          </div>
          <div>
            <label for="mensaje-org" class="block text-xs font-mono uppercase tracking-wide text-cream/50 mb-1.5">Mensaje</label>
            <textarea id="mensaje-org" name="mensaje" rows="4" required class="w-full bg-sea border border-cream/20 rounded-sm px-3 py-2.5 text-sm focus-visible:outline-none focus-visible:border-sage"></textarea>
          </div>
          <button type="submit" class="btn-sage w-full">Pedir presupuesto</button>
        </form>
      </div>
    </div>
  </section>

  <!-- CONTACTO DIRECTO -->
  <section class="max-w-content mx-auto px-6 md:px-8 pb-24">
    <div class="border-t border-cream/10 pt-10 flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <div class="kicker text-cream/40 mb-1.5">Email directo</div>
        <a href="mailto:hola@rocioperiago.com" class="font-sans font-extrabold text-xl hover:text-ochre transition-colors">hola@rocioperiago.com</a>
      </div>
      <div class="flex gap-6">
        <a href="https://linkedin.com/in/rocioperiago" target="_blank" rel="noopener" class="text-sm text-cream/60 hover:text-cream">LinkedIn</a>
        <a href="https://www.instagram.com/rocioperiago" target="_blank" rel="noopener" class="text-sm text-cream/60 hover:text-cream">Instagram</a>
        <a href="#" class="text-sm text-cream/60 hover:text-cream">Twitter/X</a>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Los formularios se envían por ahora vía mailto como fallback.
  // TODO: conectar a un backend/servicio de formularios (p. ej. Formspree) antes de producción.
  document.querySelectorAll('form[data-audience]').forEach((form) => {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = new FormData(form as HTMLFormElement);
      const audience = (form as HTMLFormElement).dataset.audience;
      const subject = audience === 'editor' ? 'Propuesta de encargo' : 'Solicitud de presupuesto';
      const body = Array.from(data.entries()).map(([k, v]) => `${k}: ${v}`).join('\n');
      window.location.href = `mailto:hola@rocioperiago.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    });
  });
</script>
