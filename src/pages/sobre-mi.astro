---
import Layout from '../layouts/Layout.astro';
import { bioLarga, formacion, idiomas, premios } from '../data/contenido';

const parrafos = bioLarga.trim().split('\n\n');
---

<Layout
  title="Sobre mí"
  description="Rocío Periago Martínez — periodista española especializada en desarrollo, migración y medio ambiente, con más de diez años de trayectoria en el ámbito social."
>
  <section class="max-w-content mx-auto px-6 md:px-8 pt-16 pb-20">
    <div class="grid md:grid-cols-[280px_1fr] gap-10 md:gap-16">
      <!-- FOTO -->
      <div>
        <div class="aspect-[4/5] bg-sea-2 rounded-md border border-cream/10 flex items-center justify-center">
          <span class="font-mono text-[.65rem] uppercase tracking-wide text-cream/30 text-center px-4">
            Foto profesional<br />pendiente
          </span>
        </div>
        <a href="/cv-rocio-periago.pdf" class="btn-outline w-full text-center mt-4">Descargar CV (PDF)</a>
      </div>

      <!-- BIO -->
      <div>
        <p class="eyebrow-ochre mb-3">Sobre mí</p>
        <h1 class="font-serif text-4xl md:text-5xl mb-8">Rocío Periago Martínez</h1>
        <div class="space-y-5 text-cream/80 max-w-2xl leading-relaxed">
          {parrafos.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </div>
  </section>

  <!-- RECONOCIMIENTOS -->
  <section class="border-y border-cream/10 bg-sea-2/30">
    <div class="max-w-content mx-auto px-6 md:px-8 py-14">
      <h2 class="font-serif text-2xl mb-8">Reconocimientos</h2>
      <div class="grid sm:grid-cols-3 gap-8">
        {premios.map((premio) => (
          <div>
            <div class="font-mono text-xs text-ochre mb-1">{premio.año}</div>
            <div class="font-serif text-lg mb-1">{premio.nombre}</div>
            <div class="text-sm text-cream/55">{premio.sub}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FORMACIÓN + IDIOMAS -->
  <section class="max-w-content mx-auto px-6 md:px-8 py-16">
    <div class="grid md:grid-cols-2 gap-14">
      <div>
        <h2 class="font-serif text-2xl mb-6">Formación</h2>
        <div class="space-y-5">
          {formacion.map((f) => (
            <div class="pb-5 border-b border-cream/10">
              <div class="flex justify-between gap-4">
                <div class="font-serif text-lg">{f.titulo}</div>
                <div class="font-mono text-xs text-cream/40 flex-shrink-0 pt-1">{f.años}</div>
              </div>
              <div class="text-sm text-cream/55 mt-1">{f.sub}</div>
            </div>
          ))}
        </div>
      </div>

      <div>
        <h2 class="font-serif text-2xl mb-6">Idiomas</h2>
        <div class="space-y-4">
          {idiomas.map((i) => (
            <div>
              <div class="flex justify-between text-sm mb-1.5">
                <span>{i.idioma}</span>
              </div>
              <div class="h-1.5 bg-cream/10 rounded-full overflow-hidden">
                <div class="h-full bg-sage rounded-full" style={`width:${i.nivel}%`}></div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="max-w-content mx-auto px-6 md:px-8 pb-24">
    <div class="bg-sea-2 rounded-md p-10 md:p-14 flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div>
        <h2 class="font-serif text-2xl md:text-3xl mb-2">¿Trabajamos juntos?</h2>
        <p class="text-cream/65">Ya sea un encargo editorial o un proyecto de comunicación.</p>
      </div>
      <a href="/contacto" class="btn-ochre flex-shrink-0">Contactar</a>
    </div>
  </section>
</Layout>
