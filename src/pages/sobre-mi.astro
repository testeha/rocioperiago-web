---
import Layout from '../layouts/Layout.astro';
import { bioLarga, bioLargaEN, bioLargaIT, premios } from '../data/contenido';

const parrafosES = bioLarga.trim().split('\n\n');
const parrafosEN = bioLargaEN.trim().split('\n\n');
const parrafosIT = bioLargaIT.trim().split('\n\n');
---

<Layout
  title="Sobre mí"
  description="Rocío Periago Martínez — periodista española especializada en desarrollo, migración y medio ambiente, con más de diez años de trayectoria en el ámbito social."
>
  <section class="max-w-content mx-auto px-6 md:px-8 pt-16 pb-20">
    <div class="grid md:grid-cols-[280px_1fr] gap-10 md:gap-16">
      <!-- FOTO -->
      <div>
        <div class="aspect-[4/5] bg-sea-2 rounded-md border border-cream/10 flex items-center justify-center">
          <span class="font-mono text-[.65rem] uppercase tracking-wide text-cream/30 text-center px-4">
            Foto profesional<br />pendiente
          </span>
        </div>
        <a href="/cv-rocio-periago.pdf" class="btn-outline w-full text-center mt-4">Descargar CV (PDF)</a>
      </div>

      <!-- BIO -->
      <div>
        <div class="flex items-center justify-between flex-wrap gap-4 mb-3">
          <p class="eyebrow-ochre">Sobre mí</p>
          <div class="flex gap-1" id="bio-lang-switch">
            <button data-lang="es" class="bio-lang-btn is-active font-mono text-[.68rem] uppercase tracking-wide px-2.5 py-1 rounded-sm border border-ochre bg-ochre text-sea">ES</button>
            <button data-lang="en" class="bio-lang-btn font-mono text-[.68rem] uppercase tracking-wide px-2.5 py-1 rounded-sm border border-cream/25 text-cream/60 hover:border-cream/50">EN</button>
            <button data-lang="it" class="bio-lang-btn font-mono text-[.68rem] uppercase tracking-wide px-2.5 py-1 rounded-sm border border-cream/25 text-cream/60 hover:border-cream/50">IT</button>
          </div>
        </div>
        <h1 class="font-sans font-extrabold text-4xl md:text-5xl mb-8">Rocío Periago Martínez</h1>

        <div class="space-y-5 text-cream/80 max-w-2xl leading-relaxed bio-content" data-lang="es">
          {parrafosES.map((p) => <p>{p}</p>)}
        </div>
        <div class="space-y-5 text-cream/80 max-w-2xl leading-relaxed bio-content hidden" data-lang="en">
          {parrafosEN.map((p) => <p>{p}</p>)}
        </div>
        <div class="space-y-5 text-cream/80 max-w-2xl leading-relaxed bio-content hidden" data-lang="it">
          {parrafosIT.map((p) => <p>{p}</p>)}
        </div>

        <div class="flex gap-6 mt-8">
          <a href="https://www.instagram.com/rocioperiago" target="_blank" rel="noopener" class="text-sm text-cream/60 hover:text-ochre transition-colors">Instagram</a>
          <a href="https://linkedin.com/in/rocioperiago" target="_blank" rel="noopener" class="text-sm text-cream/60 hover:text-ochre transition-colors">LinkedIn</a>
        </div>
      </div>
    </div>
  </section>

  <!-- RECONOCIMIENTOS -->
  <section class="border-y border-cream/10 bg-sea-2/30">
    <div class="max-w-content mx-auto px-6 md:px-8 py-14">
      <h2 class="font-sans font-extrabold text-2xl mb-8">Reconocimientos</h2>
      <div class="grid sm:grid-cols-3 gap-8">
        {premios.map((premio) => (
          <div>
            <div class="font-mono text-xs text-ochre mb-1">{premio.año}</div>
            <div class="font-serif text-lg mb-1">{premio.nombre}</div>
            <div class="text-sm text-cream/55">{premio.sub}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="max-w-content mx-auto px-6 md:px-8 py-24">
    <div class="bg-sea-2 rounded-md p-10 md:p-14 flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div>
        <h2 class="font-sans font-extrabold text-2xl md:text-3xl mb-2">¿Trabajamos juntos?</h2>
        <p class="text-cream/65">Ya sea un encargo editorial o un proyecto de comunicación.</p>
      </div>
      <a href="/contacto" class="btn-ochre flex-shrink-0">Contactar</a>
    </div>
  </section>
</Layout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.bio-lang-btn');
  const contents = document.querySelectorAll<HTMLDivElement>('.bio-content');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => {
        b.classList.remove('is-active', 'bg-ochre', 'text-sea', 'border-ochre');
        b.classList.add('border-cream/25', 'text-cream/60');
      });
      btn.classList.add('is-active', 'bg-ochre', 'text-sea', 'border-ochre');
      btn.classList.remove('border-cream/25', 'text-cream/60');

      const lang = btn.dataset.lang;
      contents.forEach((c) => {
        c.classList.toggle('hidden', c.dataset.lang !== lang);
      });
    });
  });
</script>
