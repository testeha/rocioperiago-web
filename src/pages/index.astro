---
import Layout from '../layouts/Layout.astro';
import { trabajosDestacados } from '../data/trabajos';

const medios = ['El País', 'National Geographic', 'France 24', 'Altaïr Magazine', 'Revista Haz', 'Revista Late', 'Ballena Blanca', 'Mundo Negro'];
const proyectosCon = ['ACCEM', 'Asociación Achalay', 'Instituto de Empresa', 'Aplica', 'Cooperama'];

const capsulaHero = [
  { label: '2020', valor: 'Premio Ciudad de Alcalá' },
  { label: '2017', valor: 'Premio Manos Unidas' },
];
---

<Layout
  title="Periodista freelance · Comunicación digital"
  description="Rocío Periago — Periodista freelance especializada en medio ambiente, migración y justicia social. Comunicación digital para ONGs y empresas con valores."
  transparentHero
>
  <!-- HERO -->
  <section class="relative overflow-hidden h-screen flex flex-col bg-[repeating-linear-gradient(135deg,theme(colors.sea.3)_0px,theme(colors.sea.3)_2px,theme(colors.sea.DEFAULT)_2px,theme(colors.sea.DEFAULT)_4px)]">
    <div class="absolute inset-0 bg-gradient-to-b from-sea/15 via-sea/40 to-sea pointer-events-none"></div>
    <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
      <span class="font-mono text-[.65rem] uppercase tracking-wide text-cream/20">Retrato editorial de Rocío en el terreno · pendiente</span>
    </div>

    <div class="max-w-content mx-auto px-6 md:px-8 pt-10 pb-16 relative z-10 mt-auto w-full">
      <p class="dateline mb-6">Periodismo · Storytelling</p>
      <h1 class="font-sans font-extrabold text-[3rem] md:text-[4.2rem] leading-[0.98] tracking-tight mb-6">
        Rocío <span class="text-ochre-light">Periago</span>
      </h1>
      <p class="max-w-xl text-lg text-cream/80 mb-5">
        Escribo sobre personas, lugares, viajes o historias que tienen un impacto social.
        También ayudo a organizaciones sociales a comunicar su trabajo con las palabras y narrativa que mejor se ajustan a ellas.
      </p>

      <div class="flex gap-6 md:gap-8 flex-wrap mb-8">
        <span class="font-mono text-xs uppercase tracking-wide text-ochre-light flex items-center gap-2"><span class="w-[5px] h-[5px] rounded-full bg-ochre-light inline-block"></span>+10 años en el tercer sector</span>
        <span class="font-mono text-xs uppercase tracking-wide text-ochre-light flex items-center gap-2"><span class="w-[5px] h-[5px] rounded-full bg-ochre-light inline-block"></span>Proyectos transfronterizos</span>
      </div>

      <!-- CÁPSULA DE CRISTAL — 2 bloques (premios) -->
      <div class="inline-flex items-stretch bg-cream/10 backdrop-blur-md border border-cream/20 rounded-full p-1.5 flex-wrap">
        {capsulaHero.map((item, i) => (
          <div class:list={['px-5 py-3 flex flex-col gap-0.5 justify-center', i < capsulaHero.length - 1 && 'border-r border-cream/15']}>
            <span class="font-mono text-[.62rem] uppercase tracking-wide text-ochre-light">{item.label}</span>
            <span class="text-sm text-cream font-medium whitespace-nowrap">{item.valor}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- INDICADOR DE SCROLL -->
    <a
      href="#bloque-1"
      aria-label="Bajar al siguiente bloque"
      class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 w-11 h-11 rounded-full border border-cream/25 flex items-center justify-center text-cream/70 hover:text-cream hover:border-cream/50 transition-colors animate-bounce-slow"
    >
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M8 2v11M3 9l5 5 5-5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </section>

  <!-- BLOQUE 1 · Para editores y medios -->
  <section id="bloque-1" class="border-t-2 border-ochre/40 bg-ochre/[0.025] scroll-mt-20">
    <div class="max-w-content mx-auto px-6 md:px-8 py-16">
      <p class="eyebrow-ochre mb-3">Para editores y medios</p>
      <h2 class="font-sans font-extrabold text-3xl md:text-4xl mb-4">Reportajes, artículos y entrevistas</h2>
      <p class="text-cream/70 max-w-2xl mb-12">
        Reportajes y crónicas sobre medio ambiente, migración, justicia social y viajes, publicados en medios
        nacionales e internacionales desde 2012.
      </p>

      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
        <h3 class="font-sans font-extrabold text-xl md:text-2xl">Últimos trabajos publicados</h3>
        <a href="/trabajos" class="inline-flex items-center gap-2 text-sm text-ochre hover:text-ochre-light transition-colors flex-shrink-0">
          Ver trabajos
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
        {trabajosDestacados.map((t) => (
          <a
            href={t.url}
            target="_blank"
            rel="noopener"
            class="group relative aspect-[4/5] rounded-md overflow-hidden block bg-[repeating-linear-gradient(135deg,theme(colors.sea.3)_0px,theme(colors.sea.3)_2px,theme(colors.sea.2)_2px,theme(colors.sea.2)_4px)]"
          >
            <span class="absolute top-3 left-3 font-mono text-[.55rem] uppercase tracking-wide text-cream/20 z-0">Foto pendiente</span>

            <div class="absolute inset-0 bg-black/0 group-hover:bg-black/70 transition-colors duration-300 z-10"></div>

            <div class="absolute inset-0 z-20 flex flex-col justify-end p-4">
              {t.destacado && (
                <span class="self-start mb-2 text-[.55rem] font-mono uppercase tracking-wide bg-ochre text-sea px-1.5 py-0.5 rounded-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300">{t.destacado}</span>
              )}
              <span class="font-sans font-extrabold text-white text-sm md:text-base leading-tight drop-shadow-[0_2px_6px_rgba(0,0,0,.6)]">
                {t.titulo}
              </span>
              <span class="mt-2 font-mono text-[.6rem] uppercase tracking-wide text-cream/80 opacity-0 group-hover:opacity-100 transition-opacity duration-300 delay-75">
                {t.medio} · {t.año}
              </span>
            </div>
          </a>
        ))}
      </div>

      <!-- BARRA DE PRENSA -->
      <div class="mt-12 pt-8 border-t border-cream/10 flex flex-col md:flex-row md:items-center gap-3 md:gap-8">
        <span class="kicker text-cream/40 flex-shrink-0">He publicado en</span>
        <div class="flex flex-wrap gap-x-6 gap-y-2">
          {medios.map((m) => <span class="text-sm text-cream/60">{m}</span>)}
        </div>
      </div>
    </div>
  </section>

  <!-- BLOQUE 2 · Para ONGs y empresas con valores -->
  <section class="border-t-2 border-sage/40 bg-sage/[0.025]">
    <div class="max-w-content mx-auto px-6 md:px-8 py-16">
      <div class="grid md:grid-cols-2 gap-12">
        <div>
          <p class="eyebrow-sage mb-3">Para ONGs y empresas con valores</p>
          <h2 class="font-sans font-extrabold text-3xl md:text-4xl mb-6">Storytelling con impacto social</h2>
          <ul class="space-y-3 list-none">
            <li class="text-sm text-cream/65 pt-3 border-t border-cream/10">Comunicación y estrategia de contenidos enfocada al tercer sector</li>
            <li class="text-sm text-cream/65 pt-3 border-t border-cream/10">Redacción, creación de materiales y contenidos, gestión de canales online.</li>
            <li class="text-sm text-cream/65 pt-3 border-t border-cream/10">Más de 12 años de trabajo en el ámbito social</li>
          </ul>
        </div>

        <div>
          <p class="eyebrow-sage mb-5">¿En qué puedo ayudarte?</p>

          <details class="accordion-item border-t border-cream/15 py-4" open>
            <summary class="flex items-center justify-between gap-4 cursor-pointer list-none">
              <span class="font-sans font-extrabold text-lg">Estrategia digital</span>
              <span class="accordion-icon flex-shrink-0 text-sage text-xl leading-none">+</span>
            </summary>
            <p class="mt-3 text-sm text-cream/60 leading-relaxed">Plan de comunicación. Propuestas de contenidos y acciones. Storytelling narrativo. Propuestas realistas y cercanas, poniendo el foco en las necesidades e impacto real de tu entidad.</p>
          </details>

          <details class="accordion-item border-t border-cream/15 py-4">
            <summary class="flex items-center justify-between gap-4 cursor-pointer list-none">
              <span class="font-sans font-extrabold text-lg">Comunicación corporativa y redacción</span>
              <span class="accordion-icon flex-shrink-0 text-sage text-xl leading-none">+</span>
            </summary>
            <p class="mt-3 text-sm text-cream/60 leading-relaxed">Realización de memorias, notas y convocatorias de prensa, posts y newsletter. En la era de la IA da mucha confianza saber que hay una persona real detrás de la comunicación de tu organización.</p>
          </details>

          <details class="accordion-item border-t border-b border-cream/15 py-4">
            <summary class="flex items-center justify-between gap-4 cursor-pointer list-none">
              <span class="font-sans font-extrabold text-lg">Creación de contenidos</span>
              <span class="accordion-icon flex-shrink-0 text-sage text-xl leading-none">+</span>
            </summary>
            <p class="mt-3 text-sm text-cream/60 leading-relaxed">Realización de entrevistas y reportajes. Fotografía documental. Producción y desarrollo de guiones de podcasts y materiales audiovisuales.</p>
          </details>

          <a href="/servicios" class="inline-flex items-center gap-2 mt-8 text-sm text-sage hover:text-sage-light transition-colors">
            Ver todos los servicios
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <!-- BARRA PROYECTOS CON -->
      <div class="mt-12 pt-8 border-t border-cream/10 flex flex-col md:flex-row md:items-center gap-3 md:gap-8">
        <span class="kicker text-cream/40 flex-shrink-0">Proyectos con</span>
        <div class="flex flex-wrap gap-x-6 gap-y-2">
          {proyectosCon.map((p) => <span class="text-sm text-cream/60">{p}</span>)}
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .accordion-item summary::-webkit-details-marker {
    display: none;
  }
  .accordion-item .accordion-icon {
    transition: transform 0.25s ease;
  }
  .accordion-item[open] .accordion-icon {
    transform: rotate(45deg);
  }
</style>
