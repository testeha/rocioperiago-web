---
import Layout from '../layouts/Layout.astro';
import { servicios } from '../data/contenido';
import { proyectosCliente, categoriasProyecto } from '../data/portfolio';

const categoriaKeys = Object.keys(categoriasProyecto) as (keyof typeof categoriasProyecto)[];
---

<Layout
  title="Servicios"
  description="Estrategia de comunicación digital, redacción corporativa y creación de contenidos para ONGs, fundaciones y empresas con valores, desde Testeha Estudio."
>
  <section class="max-w-content mx-auto px-6 md:px-8 pt-16 pb-10">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div>
        <p class="eyebrow-sage mb-3">Para organizaciones</p>
        <h1 class="font-sans font-extrabold text-4xl md:text-5xl mb-4">Storytelling con impacto social</h1>
        <p class="text-cream/70 max-w-xl">
          Ayudo a ONGs, fundaciones y empresas a comunicar su trabajo con honestidad, precisión y la narrativa
          que mejor se ajusta a sus necesidades. Trabajo desde Testeha Estudio, donde un equipo multidisciplinar
          de profesionales ofrecemos un servicio cercano y un contacto directo con los clientes.
        </p>
      </div>
      <a href="mailto:hola@rocioperiago.com" class="btn-sage flex-shrink-0">Contactar</a>
    </div>
  </section>

  <!-- SERVICIOS -->
  <section class="max-w-content mx-auto px-6 md:px-8 pb-20">
    <div class="grid md:grid-cols-2 gap-5">
      {servicios.map((s, i) => {
        const esOchre = i === 0 || i === 3;
        return (
        <div class:list={['rounded-md p-8 border', esOchre ? 'bg-ochre border-ochre' : 'bg-sea-2 border-cream/10']}>
          <div class:list={['font-mono text-sm mb-3', esOchre ? 'text-sea/50' : 'text-cream/30']}>{s.num}</div>
          <h2 class:list={['font-sans font-extrabold text-xl mb-3', esOchre ? 'text-sea' : 'text-cream']}>{s.nombre}</h2>
          <p class:list={['text-sm mb-5', esOchre ? 'text-sea/80' : 'text-cream/65']}>{s.descripcion}</p>
          <ul class="space-y-2 list-none">
            {s.incluye.map((item) => (
              <li class:list={['text-sm flex items-start gap-2', esOchre ? 'text-sea/85' : 'text-cream/70']}>
                <span class:list={['mt-1.5 flex-shrink-0 w-2 h-2 rounded-full inline-block', esOchre ? 'bg-sea' : 'bg-ochre']}></span>
                {item}
              </li>
            ))}
          </ul>
        </div>
        );
      })}
    </div>
  </section>

  <!-- PORTFOLIO DE PROYECTOS -->
  <section id="portfolio" class="max-w-content mx-auto px-6 md:px-8 py-20 scroll-mt-20">
    <h2 class="font-sans font-extrabold text-2xl mb-3">Organizaciones con las que he trabajado</h2>
    <p class="text-cream/60 max-w-xl mb-8">
      Estrategia, contenidos y storytelling al servicio de organizaciones que trabajan por un mundo más justo,
      humano y sostenible.
    </p>

    <div class="flex flex-wrap gap-2 mb-8" id="filtros-portfolio">
      <button data-filter="todos" class="filtro-portfolio-btn is-active font-mono text-xs uppercase tracking-wide px-3 py-1.5 rounded-full border border-ochre bg-ochre text-sea">
        Todos
      </button>
      {categoriaKeys.map((key) => (
        <button
          data-filter={key}
          class="filtro-portfolio-btn font-mono text-xs uppercase tracking-wide px-3 py-1.5 rounded-full border border-cream/25 text-cream/70 hover:border-cream/50"
        >
          {categoriasProyecto[key]}
        </button>
      ))}
    </div>

    <div class="grid md:grid-cols-3 gap-5" id="lista-portfolio">
      {proyectosCliente.map((p) => (
        <a href={`/servicios/${p.slug}`} data-categoria={p.categoria} class="proyecto-card group block rounded-md overflow-hidden bg-sea-2 border border-cream/10 hover:border-cream/25 transition-colors">
          {p.imagenPortada ? (
            <img src={p.imagenPortada} alt={p.titulo} class="w-full aspect-[4/3] object-cover" loading="lazy" />
          ) : (
            <div class="w-full aspect-[4/3] flex items-center justify-center bg-[repeating-linear-gradient(135deg,theme(colors.sea.3)_0px,theme(colors.sea.3)_2px,theme(colors.sea.2)_2px,theme(colors.sea.2)_4px)]">
              <span class="font-mono text-[.65rem] uppercase tracking-wide text-cream/30">Imagen pendiente</span>
            </div>
          )}
          <div class="p-6">
            <div class="flex items-center justify-between mb-3">
              <span class="font-mono text-[.68rem] uppercase tracking-wide text-cream/40">{p.año}</span>
              <span class="font-mono text-[.68rem] uppercase tracking-wide text-cream/40">{p.cliente}</span>
            </div>
            <h3 class="font-sans font-extrabold text-lg mb-2 group-hover:text-ochre-light transition-colors">{p.titulo}</h3>
            <p class="text-sm text-cream/60 mb-4 leading-relaxed">{p.resumenCard}</p>
            <div class="flex flex-wrap gap-1.5 mb-4">
              {p.tags.map((tag) => (
                <span class="text-[.7rem] font-mono uppercase tracking-wide border border-cream/20 text-cream/60 px-2 py-1 rounded-full">{tag}</span>
              ))}
            </div>
            <span class="inline-flex items-center gap-1.5 text-xs font-mono uppercase tracking-wide text-ochre-light group-hover:text-ochre transition-colors">
              Ver proyecto
              <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <script>
    const botonesPortfolio = document.querySelectorAll<HTMLButtonElement>('.filtro-portfolio-btn');
    const tarjetasPortfolio = document.querySelectorAll<HTMLAnchorElement>('.proyecto-card');

    botonesPortfolio.forEach((btn) => {
      btn.addEventListener('click', () => {
        botonesPortfolio.forEach((b) => {
          b.classList.remove('is-active', 'bg-ochre', 'text-sea', 'border-ochre');
          b.classList.add('border-cream/25', 'text-cream/70');
        });
        btn.classList.add('is-active', 'bg-ochre', 'text-sea', 'border-ochre');
        btn.classList.remove('border-cream/25', 'text-cream/70');

        const filtro = btn.dataset.filter;
        tarjetasPortfolio.forEach((tarjeta) => {
          const mostrar = filtro === 'todos' || tarjeta.dataset.categoria === filtro;
          tarjeta.style.display = mostrar ? '' : 'none';
        });
      });
    });
  </script>

  <!-- CTA FINAL -->
  <section class="max-w-content mx-auto px-6 md:px-8 pb-24">
    <div class="bg-sea-2 rounded-md p-10 md:p-14 flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div>
        <h2 class="font-sans font-extrabold text-2xl md:text-3xl mb-2">¿Hablamos de tu proyecto?</h2>
        <p class="text-cream/65">Cuéntame qué necesita tu organización y te propongo un plan concreto.</p>
      </div>
      <a href="/contacto" class="btn-sage flex-shrink-0">Contactar</a>
    </div>
  </section>
</Layout>
