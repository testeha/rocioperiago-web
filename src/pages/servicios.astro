---
import Layout from '../layouts/Layout.astro';
import { servicios } from '../data/contenido';
import LogosOrganizaciones from '../components/LogosOrganizaciones.astro';
---

<Layout
  title="Servicios"
  description="Estrategia de comunicación digital, redacción corporativa y creación de contenidos para ONGs, fundaciones y empresas con valores, desde Testeha Estudio."
>
  <section class="max-w-content mx-auto px-6 md:px-8 pt-16 pb-10">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div>
        <p class="eyebrow-sage mb-3">ONGs y empresas</p>
        <h1 class="font-sans font-extrabold text-4xl md:text-5xl mb-4">Storytelling con impacto social</h1>
        <p class="text-cream/70 max-w-xl">
          Ayudo a ONGs, fundaciones y empresas a comunicar su trabajo con honestidad, precisión y la narrativa
          que mejor se ajusta a sus necesidades. Trabajo desde Testeha Estudio, donde un equipo multidisciplinar
          de profesionales ofrecemos un servicio cercano y un contacto directo con los clientes.
        </p>
      </div>
    </div>
  </section>

  <!-- SERVICIOS -->
  <section class="max-w-content mx-auto px-6 md:px-8 pb-10">
    <div class="grid md:grid-cols-2 gap-5">
      {servicios.map((s, i) => {
        const esOchre = i === 0 || i === 3;
        return (
        <div class:list={['rounded-md p-8 border', esOchre ? 'bg-ochre border-ochre' : 'bg-sea-2 border-cream/10']}>
          <div class:list={['font-mono text-sm mb-3', esOchre ? 'text-sea/50' : 'text-cream/30']}>{s.num}</div>
          <h2 class:list={['font-sans font-extrabold text-xl mb-3', esOchre ? 'text-sea' : 'text-cream']}>{s.nombre}</h2>
          <p class:list={['text-sm mb-5', esOchre ? 'text-sea/80' : 'text-cream/65']}>{s.descripcion}</p>
          <ul class="space-y-2 list-none">
            {s.incluye.map((item) => (
              <li class:list={['text-sm flex items-start gap-2', esOchre ? 'text-sea/85' : 'text-cream/70']}>
                <span class:list={['mt-1.5 flex-shrink-0 w-2 h-2 rounded-full inline-block', esOchre ? 'bg-sea' : 'bg-ochre']}></span>
                {item}
              </li>
            ))}
          </ul>
        </div>
        );
      })}
    </div>
  </section>

  <!-- ORGANIZACIONES -->
  <section id="portfolio" class="max-w-content mx-auto px-6 md:px-8 pt-8 pb-24 scroll-mt-20">
    <p class="eyebrow-sage mb-3">Colaboraciones · Organizaciones</p>
    <h2 class="font-sans font-extrabold text-2xl md:text-3xl mb-14 md:mb-16">Organizaciones que han confiado en mi trabajo</h2>

    <LogosOrganizaciones />
  </section>

  <!-- CTA FINAL -->
  <section class="max-w-content mx-auto px-6 md:px-8 pb-24">
    <div class="bg-sea-2 rounded-md p-10 md:p-14 flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div>
        <h2 class="font-sans font-extrabold text-2xl md:text-3xl mb-2">¿Hablamos de tu proyecto?</h2>
        <p class="text-cream/65">Cuéntame qué necesita tu organización y te propongo un plan concreto.</p>
      </div>
      <a href="/contacto" class="btn-sage flex-shrink-0">Contactar</a>
    </div>
  </section>
</Layout>
