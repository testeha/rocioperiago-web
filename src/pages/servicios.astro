---
import Layout from '../layouts/Layout.astro';
import { servicios, procesoServicio, clientes } from '../data/contenido';
---

<Layout
  title="Servicios"
  description="Estrategia de comunicación digital, redacción corporativa y creación de contenidos para ONGs, fundaciones y empresas con valores, desde Testeha Estudio."
>
  <section class="max-w-content mx-auto px-6 md:px-8 pt-16 pb-10">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div>
        <p class="eyebrow-sage mb-3">Para organizaciones</p>
        <h1 class="font-sans font-extrabold text-4xl md:text-5xl mb-4">Storytelling con impacto social</h1>
        <p class="text-cream/70 max-w-xl">
          Ayudo a ONGs, fundaciones y empresas a comunicar su trabajo con honestidad, precisión y la narrativa
          que mejor se ajusta a sus necesidades. Trabajo desde Testeha Estudio, donde un equipo multidisciplinar
          de profesionales ofrecemos un servicio cercano y un contacto directo con los clientes.
        </p>
      </div>
      <a href="mailto:hola@rocioperiago.com" class="btn-sage flex-shrink-0">Pedir presupuesto</a>
    </div>
  </section>

  <!-- SERVICIOS -->
  <section class="max-w-content mx-auto px-6 md:px-8 pb-20">
    <div class="grid md:grid-cols-2 gap-5">
      {servicios.map((s) => (
        <div class="rounded-md p-8 border border-cream/10 bg-sea-2/40">
          <div class="font-mono text-sm text-cream/30 mb-3">{s.num}</div>
          <h2 class="font-sans font-extrabold text-xl mb-3">{s.nombre}</h2>
          <p class="text-sm text-cream/65 mb-5">{s.descripcion}</p>
          <ul class="space-y-2 list-none">
            {s.incluye.map((item) => (
              <li class="text-sm text-cream/70 flex items-start gap-2">
                <span class="wp-dot mt-1.5 flex-shrink-0"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- PROCESO -->
  <section class="border-y border-cream/10 bg-sea-2/30">
    <div class="max-w-content mx-auto px-6 md:px-8 py-16">
      <h2 class="font-sans font-extrabold text-2xl mb-10">Cómo trabajamos</h2>
      <div class="grid sm:grid-cols-4 gap-6">
        {procesoServicio.map((p) => (
          <div class="relative">
            <div class="font-mono text-2xl text-sage/60 mb-2">{p.num}</div>
            <div class="font-sans font-extrabold text-lg mb-1.5">{p.nombre}</div>
            <div class="text-sm text-cream/55">{p.desc}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CLIENTES -->
  <section class="max-w-content mx-auto px-6 md:px-8 py-20">
    <h2 class="font-sans font-extrabold text-2xl mb-10">Organizaciones con las que he trabajado</h2>
    <div class="grid md:grid-cols-3 gap-5">
      {clientes.map((c) => (
        <div class="card-sand rounded-md p-6">
          <div class="font-sans font-extrabold text-lg mb-2">{c.org}</div>
          <div class="text-sm text-ink/70 mb-4">{c.titulo}</div>
          <div class="flex flex-wrap gap-1.5">
            {c.tags.map((tag) => (
              <span class="text-[.75rem] font-medium font-mono uppercase tracking-wide bg-ink/10 text-ink/70 px-2 py-1 rounded-sm">{tag}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="max-w-content mx-auto px-6 md:px-8 pb-24">
    <div class="bg-sea-2 rounded-md p-10 md:p-14 flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div>
        <h2 class="font-sans font-extrabold text-2xl md:text-3xl mb-2">¿Hablamos de tu proyecto?</h2>
        <p class="text-cream/65">Cuéntame qué necesita tu organización y te propongo un plan concreto.</p>
      </div>
      <a href="/contacto" class="btn-sage flex-shrink-0">Pedir presupuesto</a>
    </div>
  </section>
</Layout>
